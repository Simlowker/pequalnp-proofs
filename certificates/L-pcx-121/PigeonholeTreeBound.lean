def hits (gs : List W) (s : W) := gs.countP fun g => g &&& s != 0
def good (gs : List W) := faults.all (fun a => decide (hits gs a ≤ 1))
def passes (s : W) := packs.any (fun z => decide (31 ≤ hits z.1 (~~~s) + hits z.2 s))
def col : List V → W
  | [] => 0
  | v::vs => vw v ^^^ col vs
theorem pack_sound : ∀ z ∈ packs, good z.1=true ∧ good z.2=true := by
  have ok : packs.all (fun z => good z.1 && good z.2)=true := by decide +kernel
  intro z hz
  exact Bool.and_eq_true_iff.mp (List.all_eq_true.mp ok z hz)
def splitTest (s : List V) := s.isEmpty || passes (col s)
theorem tests : ∀ vs ∈ rawVs.sublists, vs.isEmpty=false → passes (col vs)=true := by
  have ok : rawVs.sublists.all splitTest=true := by decide +kernel
  intro vs h ne
  simpa [splitTest,ne] using List.all_eq_true.mp ok vs h
theorem all_raw : ∀ v : V, v∈rawVs := by decide +kernel
theorem unique_raw : rawVs.Nodup := by decide +kernel
def boxP (i : Fin 4) : LC := linOfClause (Finset.univ.image fun j : Fin 3 => ((i,j),true))
def boxH (a b : Fin 4) (j : Fin 3) : LC := linOfClause {((a,j),false),((b,j),false)}
def pword (i : Fin 4) := ~~~(vw (i,0) ||| vw (i,1) ||| vw (i,2))
def hword (i j : Fin 4) (k : Fin 3) := vw (i,k) &&& vw (j,k)
theorem pwords : ∀ i : Fin 4, pword i ∈ faults := by decide +kernel
theorem hwords : ∀ i j : Fin 4, i≠j → ∀ k : Fin 3, hword i j k ∈ faults := by decide +kernel
def truth (C : LC) (k : I) : Bool := decide (∃ q∈C, (Odd ((q.1.filter (fun v => raw k v=true)).card) ↔ q.2=true))
theorem truth_spec (C : LC) (k : I) : truth C k=true ↔ LinClauseSat (raw k) C := by simp [truth,LinClauseSat,LinEqSat]
theorem lit (a : V→Bool) (v : V) (b : Bool) : LinEqSat a ({v},b) ↔ a v=b := by
  unfold LinEqSat
  rw [Finset.filter_singleton]
  cases h : a v <;> cases b <;> simp
theorem boxesP : ∀ i, ∃ a ∈ faults, ∀ k : I, (!truth (boxP i) k)=a.getLsbD k.val := by
  intro i
  refine ⟨pword i,pwords i,fun k => ?_⟩
  have yes : truth (boxP i) k=true ↔ ∃ j : Fin 3, raw k (i,j)=true := by
    rw [truth_spec];simp [boxP,linOfClause,LinClauseSat,lit]
  have three : (∃ j : Fin 3, raw k (i,j)=true) ↔ raw k (i,0)=true ∨ raw k (i,1)=true ∨ raw k (i,2)=true := by
    constructor
    · rintro ⟨j,hj⟩;fin_cases j <;> tauto
    · rintro (h|h|h)
      · exact ⟨0,h⟩
      · exact ⟨1,h⟩
      · exact ⟨2,h⟩
  have peq := Bool.eq_iff_iff.mpr (show truth (boxP i) k=true ↔ (raw k (i,0)||raw k (i,1)||raw k (i,2))=true by rw [yes,three];simp [or_assoc])
  simp [pword,BitVec.getLsbD_not,k.isLt,peq,raw]
theorem boxesH : ∀ i j : Fin 4, i≠j → ∀ h, ∃ z ∈ faults, ∀ k : I, (!truth (boxH i j h) k)=z.getLsbD k.val := by
  intro i j ne h
  refine ⟨hword i j h,hwords i j ne h,fun k => ?_⟩
  have yes : truth (boxH i j h) k=true ↔ raw k (i,h)=false ∨ raw k (j,h)=false := by
    rw [truth_spec];simp [boxH,linOfClause,LinClauseSat,lit]
  have peq := Bool.eq_iff_iff.mpr (show truth (boxH i j h) k=true ↔ (!(raw k (i,h) && raw k (j,h)))=true by rw [yes];simp)
  simp [peq,hword,raw]
end PigeonTree121

namespace PigeonTree121
open PEqualNP.ProofComplexity
set_option exponentiation.threshold 512
set_option maxRecDepth 12000
set_option maxHeartbeats 600000
abbrev F := (fun C => linOfClause C) '' PHP 4 3
inductive Tree : LC → Type where
  | ax (C : LC) (h : C∈F) : Tree C
  | weak {C D : LC} (t : Tree C) (h : ∀ a, LinClauseSat a C → LinClauseSat a D) : Tree D
  | res {C D R : LC} (l : Tree C) (r : Tree D) (h : IsLinResolvent C D R) : Tree R
def Tree.leaves {C : LC} : Tree C → Nat
  | .ax .. => 1
  | .weak t _ => t.leaves
  | .res l r _ => l.leaves+r.leaves
def Tree.size {C : LC} : Tree C → Nat
  | .ax .. => 1
  | .weak t _ => t.size+1
  | .res l r _ => l.size+r.size+1
theorem leaf_cost {C : LC} (t : Tree C) : 2*t.leaves ≤ t.size+1 := by
  induction t <;> simp only [Tree.size,Tree.leaves] at * <;> omega

theorem unfolds {π : List LC} (h : IsLinDerivation F π) : ∀ C∈π, Nonempty (Tree C) := by
  induction h with
  | nil => simp
  | ax h orig ih =>
    intro C hc
    rcases List.mem_cons.mp hc with rfl|prior
    · exact ⟨Tree.ax _ orig⟩
    · exact ih _ prior
  | weak h prev imp ih =>
    intro C hc
    rcases List.mem_cons.mp hc with rfl|prior
    · obtain ⟨q⟩ := ih _ prev
      exact ⟨Tree.weak q imp⟩
    · exact ih _ prior
  | res h hc hd rule ih =>
    intro C hit
    rcases List.mem_cons.mp hit with rfl|prior
    · obtain ⟨q⟩ := ih _ hc
      obtain ⟨r⟩ := ih _ hd
      exact ⟨Tree.res q r rule⟩
    · exact ih _ prior

theorem ax_mask (C : LC) (h : C∈F) :
    ∃ a ∈ faults, ∀ k : I, ¬LinClauseSat (raw k) C → a.getLsbD k.val=true := by
  obtain ⟨d,hd,rfl⟩ := h
  rcases hd with ⟨i,rfl⟩ | ⟨i,j,k,ne,rfl⟩
  · obtain ⟨a,ha,eq⟩ := boxesP i
    refine ⟨a,ha,fun k hn => ?_⟩
    rw [←eq]
    have nt : truth (boxP i) k≠true := fun ht => hn ((truth_spec _ _).1 ht)
    simpa using nt
  · obtain ⟨a,ha,eq⟩ := boxesH i j ne k
    refine ⟨a,ha,fun k' hn => ?_⟩
    rw [←eq]
    have nt : truth (boxH i j k) k'≠true := fun ht => hn ((truth_spec _ _).1 ht)
    simpa using nt

theorem resolve_false {C D R : LC} (p : IsLinResolvent C D R) (a : V → Bool) (no : ¬LinClauseSat a R) :
    ¬LinClauseSat a C ∨ ¬LinClauseSat a D := by
  obtain ⟨f,hf,hg,rfl⟩ := p
  by_contra! yes
  obtain ⟨u,hu,su⟩ := yes.1
  obtain ⟨v,hv,sv⟩ := yes.2
  by_cases eu : u=(f,false)
  · by_cases ev : v=(f,true)
    · subst u;subst v;exact Bool.noConfusion (su.mp (sv.mpr rfl))
    · exact no ⟨v,Finset.mem_union_right _ (Finset.mem_erase.mpr ⟨ev,hv⟩),sv⟩
  · exact no ⟨u,Finset.mem_union_left _ (Finset.mem_erase.mpr ⟨eu,hu⟩),su⟩

def unionW : List W → W
  | [] => 0
  | a::t => a ||| unionW t
theorem union_app (xs ys : List W) : unionW (xs++ys)=unionW xs ||| unionW ys := by
  induction xs with
  | nil => simp [unionW]
  | cons a xs ih => simp [unionW,ih,BitVec.or_assoc]
theorem leaf_cover {C : LC} (t : Tree C) :
    ∃ L : List W, L.length=t.leaves ∧ (∀ a ∈ L, a∈faults) ∧
      ∀ k : I, ¬LinClauseSat (raw k) C → (unionW L).getLsbD k.val=true := by
  induction t with
  | ax C h =>
    obtain ⟨a,ha,hf⟩ := ax_mask C h
    exact ⟨[a],rfl,by simpa using ha,by simpa [unionW] using hf⟩
  | weak t h ih =>
    obtain ⟨L,len,ok,cv⟩ := ih
    exact ⟨L,len,ok,fun k bad => cv k (fun hc => bad (h _ hc))⟩
  | res l r p il ir =>
    obtain ⟨L,leq,lc,lh⟩ := il
    obtain ⟨R,req,rc,rh⟩ := ir
    refine ⟨L++R,by simp [Tree.leaves,leq,req],(fun a h => (List.mem_append.mp h).elim (lc a) (rc a)),?_⟩
    intro k n
    rw [union_app,BitVec.getLsbD_or,Bool.or_eq_true]
    exact (resolve_false p _ n).imp (lh k) (rh k)

theorem hits_or (gs : List W) (a b : W) : hits gs (a ||| b) ≤ hits gs a+hits gs b := by
  induction gs with
  | nil => simp [hits]
  | cons g gs ih =>
    have step (s : W) : hits (g::gs) s = hits gs s + (if g &&& s = 0 then 0 else 1) := by
      simp [hits,List.countP_cons]
    rw [step,step,step,BitVec.and_or_distrib_left]
    by_cases x : g &&& a=0
    · rw [x,ite_eq_left rfl]
      have zor (z : W) : (0:W) ||| z=z := BitVec.zero_or
      rw [zor]
      split <;> omega
    · rw [ite_eq_right x]
      split <;> split <;> omega

theorem hits_cover (gs : List W) (ok : good gs=true) (L : List W) (h : ∀ a ∈ L, a∈faults) :
    hits gs (unionW L) ≤ L.length := by
  induction L with
  | nil => simp [unionW,hits]
  | cons a t ih =>
    have one := of_decide_eq_true (List.all_eq_true.mp ok a (h _ List.mem_cons_self))
    have tail := ih (fun x hx => h x (List.mem_cons_of_mem _ hx))
    have cost := hits_or gs a (unionW t)
    change hits gs (a ||| unionW t) ≤ t.length+1
    omega

theorem hits_mono (gs : List W) (s t : W) (le : ∀ i : I, s.getLsbD i.val=true → t.getLsbD i.val=true) :
    hits gs s ≤ hits gs t := by
  have keep (g : W) (h : g &&& s≠0) : g &&& t≠0 := by
    intro no
    apply h
    apply BitVec.eq_of_getLsbD_eq_iff.mpr
    intro i hi
    have z := congrArg (fun q : W => q.getLsbD i) no
    simp only [BitVec.getLsbD_and,BitVec.getLsbD_zero] at z ⊢
    cases hg : g.getLsbD i <;> simp [hg] at z ⊢
    cases hs : s.getLsbD i with
    | false => rfl
    | true => exact Bool.noConfusion ((le ⟨i,hi⟩ hs).symm.trans z)
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    simp only [hits,List.countP_cons] at ih ⊢
    by_cases h : g &&& s=0 <;> by_cases j : g &&& t=0 <;> simp_all <;> omega

theorem col_parity (vs : List V) (nodup : vs.Nodup) (k : I) :
    (col vs).getLsbD k.val=true ↔ Odd ((vs.toFinset.filter (fun v => raw k v=true)).card) := by
  induction vs with
  | nil => simp [col]
  | cons v vs ih =>
    obtain ⟨nv,nd⟩ := List.nodup_cons.mp nodup
    have notin : v∉vs.toFinset.filter (fun v => raw k v=true) := fun h => nv (List.mem_toFinset.mp (Finset.mem_filter.mp h).1)
    have h := ih nd
    simp only [col,BitVec.getLsbD_xor,List.toFinset_cons]
    change (raw k v ^^ (col vs).getLsbD k.val)=true ↔ _
    by_cases on : raw k v=true
    · rw [on,Finset.filter_insert,ite_eq_left on,Finset.card_insert_of_notMem notin]
      cases q : (col vs).getLsbD k.val with
      | false =>
        have even : ¬ Odd ((vs.toFinset.filter (fun v => raw k v=true)).card) := fun o => Bool.noConfusion (q.symm.trans (h.mpr o))
        simpa using (Nat.odd_add_one.mpr even)
      | true =>
        have odd := h.mp q
        simp [Nat.odd_add_one,odd]
    · simp [on,Finset.filter_insert] at *
      tauto

theorem fork_bad {f : Finset V} {C D : LC} (h : ∀ a, ¬LinClauseSat a (C.erase (f,false) ∪ D.erase (f,true))) :
    (∀ a, Odd (f.filter (fun v => a v=true)).card → ¬LinClauseSat a C) ∧
    (∀ a, ¬Odd (f.filter (fun v => a v=true)).card → ¬LinClauseSat a D) := by
  constructor
  · rintro a par ⟨q,hq,sat⟩
    by_cases e : q=(f,false)
    · exact Bool.noConfusion ((e ▸ sat).mp par)
    · exact h a ⟨q,Finset.mem_union_left _ (Finset.mem_erase.mpr ⟨e,hq⟩),sat⟩
  · rintro a par ⟨q,hq,sat⟩
    by_cases e : q=(f,true)
    · exact par ((e ▸ sat).mpr rfl)
    · exact h a ⟨q,Finset.mem_union_right _ (Finset.mem_erase.mpr ⟨e,hq⟩),sat⟩

theorem leaves_lower {C : LC} (t : Tree C) (no : ∀ a, ¬LinClauseSat a C) : 31 ≤ t.leaves := by
  induction t with
  | ax c h =>
    obtain ⟨d,hd,rfl⟩ := h
    rcases hd with ⟨i,rfl⟩ | ⟨i,j,k,ne,rfl⟩
    · exact False.elim (no (fun _ => true) ⟨({(i,0)},true),by simp [linOfClause],by simp [LinEqSat]⟩)
    · exact False.elim (no (fun _ => false) ⟨({(i,k)},false),by simp [linOfClause],by simp [LinEqSat]⟩)
  | weak t h ih => exact ih (fun a hc => no a (h a hc))
  | @res c d r l t h il ir =>
    obtain ⟨f,hc,hd,rfl⟩ := h
    have fork := fork_bad no
    by_cases empty : f=∅
    · subst f
      have tmp := ir (fun a => fork.2 a (by simp))
      change 31 ≤ l.leaves+t.leaves
      omega
    · let vs := rawVs.filter (fun v => decide (v∈f))
      have eq : vs.toFinset=f := by ext v;simp [vs,all_raw]
      have nd : vs.Nodup := unique_raw.filter _
      have ne : vs.isEmpty=false := by
        cases ev : vs with
        | nil => simp only [ev,List.toFinset_nil] at eq;exact (empty eq.symm).elim
        | cons a b => rfl
      obtain ⟨z,hz,val⟩ := List.any_eq_true.mp (tests vs (List.mem_sublists.mpr (List.filter_sublist)) ne)
      have gv := pack_sound z hz
      obtain ⟨L,ll,lm,lv⟩ := leaf_cover l
      obtain ⟨R,rr,rm,rv⟩ := leaf_cover t
      have pos : hits z.2 (col vs) ≤ l.leaves := by
        rw [←ll]
        apply (hits_mono _ _ (unionW L) ?_).trans (hits_cover _ gv.2 _ lm)
        intro i hi
        exact lv i (fork.1 _ (eq ▸ (col_parity vs nd i).mp hi))
      have neg : hits z.1 (~~~(col vs)) ≤ t.leaves := by
        rw [←rr]
        apply (hits_mono _ _ (unionW R) ?_).trans (hits_cover _ gv.1 _ rm)
        intro i hi
        have off : (col vs).getLsbD i.val=false := by simpa [BitVec.getLsbD_not,i.isLt] using hi
        apply rv i (fork.2 _ ?_)
        intro h
        exact Bool.noConfusion (((col_parity vs nd i).mpr (eq.symm ▸ h)).symm.trans off)
      have sum := of_decide_eq_true val
      change 31 ≤ l.leaves+t.leaves
      omega

theorem size_lower (t : Tree ∅) : 61 ≤ t.size := by
  have a := leaf_cost t
  have b := leaves_lower t (by simp [LinClauseSat])
  omega
/-- An expansion uses exactly the axioms, semantic weakening, and resolution
rules of the project. Each time a derived line is used twice its proof can
be unfolded twice. -/
def Tree.lines {C : LC} : Tree C → List LC
  | .ax c _ => [c]
  | @Tree.weak _ d t _ => d::t.lines
  | @Tree.res _ _ r l t _ => r::(l.lines++t.lines)
theorem extract {π : List LC} (h : IsLinDerivation F π) :
    ∀ C∈π, ∃ t : Tree C, ∀ d∈t.lines, d∈π := by
  induction h with
  | nil => simp
  | ax prev orig ih =>
    intro C hc
    rcases List.mem_cons.mp hc with rfl|prior
    · exact ⟨Tree.ax _ orig,by simp [Tree.lines]⟩
    · obtain ⟨t,ht⟩ := ih _ prior
      exact ⟨t,fun d hd => List.mem_cons_of_mem _ (ht d hd)⟩
  | weak prev source imp ih =>
    intro C hc
    rcases List.mem_cons.mp hc with rfl|prior
    · obtain ⟨t,ht⟩ := ih _ source
      refine ⟨Tree.weak t imp,fun d hd => ?_⟩
      exact (List.mem_cons.mp hd).elim (fun e => e ▸ List.mem_cons_self) (fun a => List.mem_cons_of_mem _ (ht d a))
    · obtain ⟨t,ht⟩ := ih _ prior
      exact ⟨t,fun d hd => List.mem_cons_of_mem _ (ht d hd)⟩
  | res prev left right rule ih =>
    intro C hc
    rcases List.mem_cons.mp hc with rfl|prior
    · obtain ⟨l,hl⟩ := ih _ left
      obtain ⟨r,hr⟩ := ih _ right
      refine ⟨Tree.res l r rule,fun d hd => ?_⟩
      rcases List.mem_cons.mp hd with e|child
      · exact e ▸ List.mem_cons_self
      · exact List.mem_cons_of_mem _ ((List.mem_append.mp child).elim (hl d) (hr d))
    · obtain ⟨t,ht⟩ := ih _ prior
      exact ⟨t,fun d hd => List.mem_cons_of_mem _ (ht d hd)⟩

theorem short_refutation_expansion {π : List LC} (p : IsLinRefutation (PHP 4 3) π) (cap : π.length≤55) :
    ∃ t : Tree ∅, (∀ C∈t.lines, C∈π) ∧ π.length+6≤t.size := by
  obtain ⟨t,uses⟩ := extract p.1 ∅ p.2
  exact ⟨t,uses,by have := size_lower t;omega⟩

end PigeonTree121

namespace PigeonTree121
open PEqualNP.ProofComplexity
set_option maxHeartbeats 800000
set_option maxRecDepth 16000
def Tree.origins {C : LC} : Tree C → Finset LC
  | .ax c _ => {c}
  | .weak t _ => t.origins
  | .res l r _ => l.origins ∪ r.origins
theorem origins_in {C : LC} (t : Tree C) : ∀ d∈t.origins,d∈F := by
  induction t with
  | ax c h => simpa [Tree.origins] using h
  | weak t _ ih => exact ih
  | res l r _ il ir =>
    intro d hd
    exact (Finset.mem_union.mp hd).elim (il d) (ir d)
theorem origin_bad {C : LC} (t : Tree C) (a : V→Bool) (bad : ¬LinClauseSat a C) :
    ∃ d∈t.origins, ¬LinClauseSat a d := by
  induction t with
  | ax c h => exact ⟨c,Finset.mem_singleton_self _,bad⟩
  | weak t h ih => exact ih (fun v => bad (h a v))
  | res l r h il ir =>
    rcases resolve_false h a bad with left|right
    · obtain ⟨d,hd,bd⟩ := il left
      exact ⟨d,Finset.mem_union_left _ hd,bd⟩
    · obtain ⟨d,hd,bd⟩ := ir right
      exact ⟨d,Finset.mem_union_right _ hd,bd⟩
noncomputable def fault (C : LC) : W := by
  classical
  exact if h : C∈F then (ax_mask C h).choose else 0
theorem fault_spec (C : LC) (h : C∈F) : fault C∈faults ∧
    ∀ k : I, ¬LinClauseSat (raw k) C → (fault C).getLsbD k.val=true := by
  simpa [fault,h] using (ax_mask C h).choose_spec
theorem union_read {a : W} {xs : List W} {k : I} (h : a∈xs) (yes : a.getLsbD k.val=true) :
    (unionW xs).getLsbD k.val=true := by
  induction xs with
  | nil => simp at h
  | cons b xs ih =>
    rw [unionW,BitVec.getLsbD_or,Bool.or_eq_true]
    exact (List.mem_cons.mp h).elim (fun e => Or.inl (e ▸ yes)) (fun hh => Or.inr (ih hh))
theorem origins_bound {C : LC} (t : Tree C) (gs : List W) (ok : good gs=true) (p : W)
    (bad : ∀ k : I, p.getLsbD k.val=true → ¬LinClauseSat (raw k) C) : hits gs p ≤ t.origins.card := by
  classical
  let xs := t.origins.toList.map fault
  have mono : hits gs p ≤ hits gs (unionW xs) := by
    apply hits_mono
    intro i hi
    obtain ⟨c,hc,fail⟩ := origin_bad t _ (bad i hi)
    have hx : fault c∈xs := List.mem_map.mpr ⟨c,Finset.mem_toList.mpr hc,rfl⟩
    exact union_read hx ((fault_spec c (origins_in t c hc)).2 i fail)
  have hxs : ∀ a∈xs,a∈faults := by
    intro a ha
    obtain ⟨c,hc,rfl⟩ := List.mem_map.mp ha
    exact (fault_spec c (origins_in t c (Finset.mem_toList.mp hc))).1
  simpa [xs] using mono.trans (hits_cover gs ok xs hxs)

def allSources : Finset LC := ([boxP 0,boxP 1,boxP 2,boxP 3,
  boxH 0 1 0,boxH 0 2 0,boxH 0 3 0,boxH 1 2 0,boxH 1 3 0,boxH 2 3 0,
  boxH 0 1 1,boxH 0 2 1,boxH 0 3 1,boxH 1 2 1,boxH 1 3 1,boxH 2 3 1,
  boxH 0 1 2,boxH 0 2 2,boxH 0 3 2,boxH 1 2 2,boxH 1 3 2,boxH 2 3 2] : List LC).toFinset
theorem source_card : allSources.card=22 := by decide +kernel
theorem source_in {C : LC} (h : C∈F) : C∈allSources := by
  have hp : ∀ i, boxP i∈allSources := by decide +kernel
  have hh : ∀ i j : Fin 4, i≠j → ∀ k, boxH i j k∈allSources := by decide +kernel
  obtain ⟨D,hd,rfl⟩ := h
  rcases hd with ⟨i,rfl⟩ | ⟨i,j,k,n,rfl⟩
  · exact hp i
  · exact hh i j n k
theorem overlap {C D : LC} (l : Tree C) (r : Tree D) (f : Finset V) (nonzero : f≠∅)
    (unsat : ∀ a, ¬LinClauseSat a (C.erase (f,false) ∪ D.erase (f,true))) :
    9 ≤ (l.origins∩r.origins).card := by
  let vs := rawVs.filter (fun v => decide (v∈f))
  have eq : vs.toFinset=f := by ext v;simp [vs,all_raw]
  have nd : vs.Nodup := unique_raw.filter _
  have ne : vs.isEmpty=false := by
    cases ev : vs with
    | nil => simp only [ev,List.toFinset_nil] at eq;exact (nonzero eq.symm).elim
    | cons a b => rfl
  obtain ⟨z,hz,value⟩ := List.any_eq_true.mp (tests vs (List.mem_sublists.mpr List.filter_sublist) ne)
  have gv := pack_sound z hz
  have fork := fork_bad unsat
  have lp := origins_bound l z.2 gv.2 (col vs) (fun i hi => fork.1 _ (eq ▸ (col_parity vs nd i).mp hi))
  have rp := origins_bound r z.1 gv.1 (~~~(col vs)) (by
    intro i hi
    have off : (col vs).getLsbD i.val=false := by simpa [BitVec.getLsbD_not,i.isLt] using hi
    apply fork.2 _ ?_
    intro h
    exact Bool.noConfusion (((col_parity vs nd i).mpr (eq.symm ▸ h)).symm.trans off))
  have ub : (l.origins∪r.origins).card ≤ 22 := by
    rw [← source_card]
    apply Finset.card_le_card
    intro d hd
    exact source_in ((Finset.mem_union.mp hd).elim (origins_in l d) (origins_in r d))
  have sum := of_decide_eq_true value
  have ie := Finset.card_union_add_card_inter l.origins r.origins
  omega
def Tree.hasOverlap {C : LC} : Tree C → Prop
  | .ax .. => False
  | .weak t _ => t.hasOverlap
  | .res l r _ => 9 ≤ (l.origins ∩ r.origins).card ∨ l.hasOverlap ∨ r.hasOverlap

theorem needs_overlap {C : LC} (t : Tree C) (bad : ∀ a, ¬LinClauseSat a C) : t.hasOverlap := by
  induction t with
  | ax c h =>
    have impossible := leaves_lower (Tree.ax c h) bad
    norm_num [Tree.leaves] at impossible
  | weak t imp ih => exact ih (fun a hc => bad a (imp a hc))
  | @res c d r l t h il ir =>
    obtain ⟨f,hc,hd,rfl⟩ := h
    by_cases e : f=∅
    · subst f
      exact Or.inr (Or.inr (ir (fun a => (fork_bad bad).2 a (by simp))))
    · exact Or.inl (overlap l t f e bad)

theorem refutation_shape {π : List LC} (p : IsLinRefutation (PHP 4 3) π) :
    ∃ t : Tree ∅, (∀ C∈t.lines, C∈π) ∧ t.hasOverlap ∧ 61≤t.size := by
  obtain ⟨t,uses⟩ := extract p.1 ∅ p.2
  exact ⟨t,uses,needs_overlap t (by simp [LinClauseSat]),size_lower t⟩
end PigeonTree121

namespace PigeonWitness121
open PEqualNP.ProofComplexity
set_option maxRecDepth 30000
set_option maxHeartbeats 1000000
abbrev V := Fin 4 × Fin 3
abbrev LC := LinClause V
abbrev F := (fun C => linOfClause C) '' PHP 4 3
def c0 : LC := {({(0,0)},true), ({(0,1)},true), ({(0,2)},true)}
def l0 : List LC := c0::[]
theorem h0 : IsLinDerivation F l0 :=
  IsLinDerivation.ax IsLinDerivation.nil ⟨(Finset.univ.image fun h : Fin 3 => (((0:Fin 4),h),true)),Or.inl ⟨0,rfl⟩,by decide +kernel⟩
def c1 : LC := {({(1,0)},true), ({(1,1)},true), ({(1,2)},true)}
def l1 : List LC := c1::l0
